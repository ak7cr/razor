# ── LLM (OpenAI-compatible) ──────────────────────────────────────────────
# Any provider exposing /chat/completions works: OpenAI, OpenRouter,
# Together, Groq, a local proxy, etc.
# If unset, the demo runs with a deterministic heuristic buyer (no key needed).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ── Razorpay (test mode) ─────────────────────────────────────────────────
# Optional. If unset, the app uses a built-in mock payment provider so the
# whole demo works offline. Get test keys from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Server ───────────────────────────────────────────────────────────────
PORT=4173

# Money-action guardrails (see src/guards/moneyGuards.ts)
MAX_ORDER_AMOUNT_INR=25000
MAX_QTY_PER_LINE=5
MAX_LINE_ITEMS=10
